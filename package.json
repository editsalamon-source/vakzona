{
  "name": "vakzona",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "start:host": "vite --host 0.0.0.0",
    "build": "node scripts/sitemap.mjs && node scripts/tanfolyamok.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0",
    "pdf": "node scripts/pdf.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name vakzona --branch main",
    "preview:cf": "npm run build && wrangler pages dev dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^13.4.5",
    "html-to-image": "^1.11.11",
    "jspdf": "^4.2.1",
    "marked": "^18.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1",
    "wrangler": "^4.169.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261127.1": true
  }
}
