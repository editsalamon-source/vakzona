{
  "redirects": [
    {
      "source": "/tortenelem",
      "destination": "/tudomany",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.vakzona.com"
        }
      ],
      "destination": "https://vakzona.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/ebreszto",
      "schedule": "0 6 * * *"
    }
  ]
}
